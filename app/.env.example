# Azure AI Foundry configuration - ENTRA ID AUTH
# ⚠️ disableLocalAuth=true enforced - NO API keys work
# Backend must use DefaultAzureCredential()

PROJECT_ENDPOINT=https://your-foundry-resource.openai.azure.com
MODEL_DEPLOYMENT_NAME=gpt-4.1
BING_CONNECTION_NAME=bing-grounding

# Image generation configuration
IMAGE_ENDPOINT=https://your-image-resource.openai.azure.com
IMAGE_DEPLOYMENT=gpt-image-2
IMAGE_API_VERSION=2025-04-01-preview

# Bing Grounding (if connection creation fails, use key directly)
BING_API_KEY=your-bing-key-here

# Required RBAC roles for user/service principal:
# - Cognitive Services User
# - Cognitive Services OpenAI User  
# - Azure AI User