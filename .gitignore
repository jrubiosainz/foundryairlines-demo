# Squad team state (excluded from public repo)
.squad/

# Copilot CLI internal state
.copilot/

# Local agent state (Foundry-specific IDs, regenerated by bootstrap)
app/agents.json

# Scratch artifacts
response.json
.squad-workstream

# Secrets / environment
.env
app/.env

# Database (regenerated by `python -m app.backend.seed_db`)
app/data/*.db

# NOTE: app/output/*.png are intentionally committed so the cached demo
# works on a fresh clone without spending image-generation quota.

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# Node.js (if used for frontend tooling)
node_modules/
npm-debug.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
